#!/usr/bin/env bash
# Whole-program call-graph merge over a binary's shared-library closure.
#
#   cgmerge_shared_libs.sh <binary> [output.mcg]
#
# Resolves every shared library the binary pulls in (transitively, via ldd)
# and merges the binary's own .mcg with each library's .mcg into one graph.
#
# <binary>       the linked executable (or .so) to analyze
# [output.mcg]   where to write the merged graph
#                (default: <binary>.whole.mcg -- see the note below on why this
#                 does NOT overwrite <binary>.mcg by default)
#
# Runs AFTER linking (the binary must exist to resolve its deps), so wire it up
# as a POST_BUILD step on the final executable, or run it by hand.

cgmerge2_bin=${CGMERGE2_BIN:-"@CGMERGE2_BIN@"}

if [ $# -lt 1 ]; then
  echo "Usage: $(basename "$0") <binary> [output.mcg]" >&2
  exit 1
fi

binary="$1"
output="${2:-${binary}.whole.mcg}"

if [ ! -e "$binary" ]; then
  echo "Error: $binary does not exist." >&2
  exit 1
fi

if ! command -v ldd &>/dev/null; then
  echo "Error: ldd not found in PATH." >&2
  exit 1
fi

# --- collect .mcg inputs -----------------------------------------------------

inputs=()
# the binary's own (per-target) graph, if it was instrumented at link time.
[ -f "${binary}.mcg" ] && inputs+=("${binary}.mcg")

total_libs=0
missing_libs=0
# ldd emits the full transitive closure; lines look like:
#   libfoo.so.1 => /path/libfoo.so.1 (0x...)
# keep only entries that resolved to an absolute path.
while IFS= read -r lib; do
  [ -n "$lib" ] || continue
  total_libs=$((total_libs + 1))
  # ldd may report a symlink (libfoo.so.1 -> libfoo.so.1.2.3); the .mcg might
  # sit next to either name, so check the reported path and its real target.
  mcg=""
  if [ -f "${lib}.mcg" ]; then
    mcg="${lib}.mcg"
  else
    real=$(readlink -f "$lib" 2>/dev/null)
    [ -n "$real" ] && [ -f "${real}.mcg" ] && mcg="${real}.mcg"
  fi
  if [ -n "$mcg" ]; then
    inputs+=("$mcg")
  else
    missing_libs=$((missing_libs + 1))
  fi
done < <(ldd "$binary" 2>/dev/null | awk '/=>/ && $3 ~ /^\// { print $3 }' | sort -u)

# drop duplicates (distinct symlinks can resolve to the same .mcg)
if [ ${#inputs[@]} -gt 0 ]; then
  mapfile -t inputs < <(printf '%s\n' "${inputs[@]}" | sort -u)
fi

# --- merge -------------------------------------------------------------------

if [ ${#inputs[@]} -eq 0 ]; then
  echo "Note: no call-graph inputs found for $binary; nothing to merge." >&2
  exit 0
fi

if [ "$missing_libs" -gt 0 ]; then
  echo "Note: $missing_libs of $total_libs shared libraries had no .mcg;" \
       "merging ${#inputs[@]} graph(s)." >&2
fi

if ! command -v "$cgmerge2_bin" &>/dev/null; then
  echo "Error: $cgmerge2_bin not found in PATH." >&2
  exit 1
fi

# Merge into a temp file first, then move into place. This keeps the operation
# safe even if <output> happens to be one of the inputs (e.g. you override the
# default and point it at <binary>.mcg).
tmp_output=$(mktemp "${output}.XXXXXX") || {
  echo "Error: could not create a temp file next to $output." >&2
  exit 1
}
trap 'rm -f "$tmp_output"' EXIT

if ! "$cgmerge2_bin" "$tmp_output" "${inputs[@]}"; then
  status=$?
  echo "Error: $cgmerge2_bin failed (exit $status) merging graphs for $binary." >&2
  exit $status
fi

mv -f "$tmp_output" "$output"
trap - EXIT
