#!/usr/bin/env bash

# Wrapper script for running cgfcollector plugin with flang.
#
# Usage:
#     cgfcollector_wrapper.sh [options] [flang options and source files]
#
# Options:
#     -d, --dot       # Additionally generate a DOT file. This is mostly used for debugging.
#     --no-rename     # Do not rename the output file.
#     -v, --verbose   # Print additional information during the generation process.
#     --graph-name    # Set internal graph name

flang_bin=${CGFCOLLECTOR_FLANG_BIN:-"flang-new"}

flang_args=()

declare -A OPTION_MAP=(
  ["-d"]="--dot"
  ["--dot"]="--dot"
  ["--no-rename"]="--no-rename"
  ["-v"]="--verbose"
  ["--verbose"]="--verbose"
  ["--graph-name"]="--graph-name"
)

while [[ $# -gt 0 ]]; do
  arg="$1"
  if [[ -n "${OPTION_MAP[$arg]}" ]]; then
    flang_args+=("-mllvm" "${OPTION_MAP[$arg]}")
  else
    flang_args+=("$arg")
  fi
  shift
done

if ! command -v "$flang_bin" &>/dev/null; then
  echo "Error: $flang_bin not found in PATH."
  exit 1
fi

$flang_bin -fc1 -load "@CGFCOLLECTOR_FILE_NAME_LIB@" -plugin "genCG" "${flang_args[@]}"
