#!/bin/bash

# Wrapper script for running cgfcollector plugin with flang.
#
# Usage:
#     cgfcollector_wrapper.sh [-dot|-norename] [flang options and source files]
#
# Options:
#     -dot         # Generate call graph with dot format
#     -norename    # Do not rename output files

flang_bin=${CGFCOLLECTOR_FLANG_BIN:-"flang-new"}

flang_args=("$@")
plugin_name="genCG"

if [[ "$1" == "-dot" ]]; then
  plugin_name="genCGwithDot"
  shift
  flang_args=("$@")
fi

if [[ "$1" == "-norename" ]]; then
  plugin_name="genCGNoRename"
  shift
  flang_args=("$@")
fi

if ! command -v "$flang_bin" &>/dev/null; then
  echo "Error: $flang_bin not found in PATH."
  exit 1
fi

$flang_bin -fc1 -load "@FCOLLECTOR_FILE_NAME@" -plugin "$plugin_name" "${flang_args[@]}"
